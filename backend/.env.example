# Runtime
NODE_ENV=development
PORT=4000

# Supabase (server-side). Leave empty to run in local development data mode
# (in-memory store, dev auth). Production must set all three.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: comma-separated list of allowed frontend origins.
# In production set this to the Lerno frontend origin only.
FRONTEND_URL=http://localhost:5173

# Optional: signs dev-mode access tokens only. Never used in production
# (production tokens are verified with Supabase Auth). Never commit a real value.
AUTH_JWT_SECRET=

# Set to "true" to include a lightweight (SELECT 1) database check in
# GET /api/health. Off by default so the endpoint stays cheap.
HEALTH_CHECK_DB=false

# Required in production AND whenever Supabase is configured: canonical HTTPS
# backend origin for MCP OAuth discovery. Dev data mode uses localhost:PORT.
# No path/trailing slash. Never derive the public issuer from an untrusted Host.
PUBLIC_BACKEND_URL=

# Lerno AI (built-in chat assistant, powered by Groq).
# Get a key at https://console.groq.com — server-side only: never commit a
# real key and never expose it to the frontend. Leave empty to disable the
# AI endpoints (they then answer 503 "not available").
GROQ_API_KEY=
# Groq chat model. Change here to switch models later.
GROQ_MODEL=openai/gpt-oss-120b
# Max tokens the model may generate for one answer (256–8192, default 2048).
GROQ_MAX_OUTPUT_TOKENS=2048
# Sampling temperature (0–2, default 0.6). Lower = more predictable answers.
GROQ_TEMPERATURE=0.6
# Reasoning effort for reasoning models (GPT-OSS).
#   auto    = per task: low for explanations/hints, medium for math, complex
#             evaluation and generation (default, recommended)
#   low|medium|high = force one level for every request (measurement switch).
# Non-reasoning models ignore it. Hidden reasoning tokens are billed and count
# against max_completion_tokens, so higher effort also means a bigger reserve.
GROQ_REASONING_EFFORT=auto
# Timeout for one Groq call, milliseconds (1000–120000, default 30000).
GROQ_TIMEOUT_MS=30000
# Retries inside the Groq SDK (0–3, default 1).
GROQ_MAX_RETRIES=1
# Ask Groq for JSON output on structured tasks (true/false, default true).
# Output is always parsed defensively and validated with Zod.
GROQ_JSON_MODE=true
# Max cards sent to the model as set context (5–200, default 60).
AI_CONTEXT_MAX_CARDS=60
# Hard ceiling on the characters of one set context (1000–40000, default 12000).
AI_CONTEXT_MAX_CHARS=12000
# Lerno AI quota per signed-in user (fallback: client IP). Much stricter than
# the normal API limits because every request costs upstream tokens.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=300000
# Wider per-IP quota, so one network with many accounts cannot burn the budget.
AI_RATE_LIMIT_IP_MAX=60

# ---------------------------------------------------------------------------
# AI content engine: source expansion (all optional, sane defaults)
# ---------------------------------------------------------------------------

# Vision model used to read text from PNG/JPG/WEBP images (OCR). Server-side only.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional official YouTube Data API v3 key. When set, Lerno reads public video
# metadata (title, channel, duration) from the official API; without it only the
# public oEmbed metadata is used and the duration stays unknown. Captions are
# never scraped: the student pastes the transcript, or the source fails honestly.
YOUTUBE_API_KEY=

# Hard upload ceiling per source kind, in bytes. Defaults: 15 MB (PDF),
# 25 MB (PowerPoint), 10 MB (image), 25 MB (audio). Out-of-range values stop the
# service at boot instead of failing at runtime.
SOURCE_MAX_PDF_BYTES=15728640
SOURCE_MAX_PPTX_BYTES=26214400
SOURCE_MAX_IMAGE_BYTES=10485760
SOURCE_MAX_AUDIO_BYTES=26214400
