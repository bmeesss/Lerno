# Runtime
NODE_ENV=development
PORT=4000

# Supabase (server-side). Leave empty to run in local development data mode
# (in-memory store, dev auth). Production must set all three.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: comma-separated list of allowed frontend origins.
# In production set this to the Lerno frontend origin only.
FRONTEND_URL=http://localhost:5173

# Optional: JWT secret used to sign/verify dev-mode access tokens and, when set,
# to verify Supabase access tokens locally. Only used if an additional
# server-side session mechanism is used. Never commit a real value.
AUTH_JWT_SECRET=

# Set to "true" to include a lightweight (SELECT 1) database check in
# GET /api/health. Off by default so the endpoint stays cheap.
HEALTH_CHECK_DB=false
