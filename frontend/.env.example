# Base URL of the Lerno API (no trailing slash).
VITE_API_BASE_URL=http://localhost:4000/api

# Public Supabase configuration (anon key only — NEVER put the service-role
# key here or anywhere in frontend code).
# Leave empty to run against the backend's local development data mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
